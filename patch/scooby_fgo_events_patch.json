// This Patch file modifies the FGO server config to add two new options: enabled_tlf_open_ids and enabled_singularity_ids. 
// These options allow Scooby to toggle individual FGO terminal banners and open-events on/off via fgo.yaml, without vendoring index.py/config.py in Scooby.

{
  "marker": "fgo_event_toggles_v1",
  "edits": [
    {
      "file": "config.py",
      "anchor_old": "    @property\n    def loglevel(self) -> int:",
      "anchor_new": "    @property\n    def enabled_tlf_open_ids(self) -> list | None:\n        # None (key absent) means \"no filter\" -- every installed terminal\n        # banner shows, exactly as before this option existed. A list\n        # (even an empty one) switches into allowlist mode: only the IDs\n        # present are shown. These two states must stay distinguishable,\n        # so the default is None, not [].\n        value = CoreConfig.get_config_field(\n            self.__config, \"fgo\", \"server\", \"enabled_tlf_open_ids\", default=None\n        )\n        return value if isinstance(value, list) else None\n\n    @property\n    def enabled_singularity_ids(self) -> list | None:\n        # Same None-vs-list convention as enabled_tlf_open_ids, applied at\n        # the actual catalog source (_tlf_open_settings) instead of only the\n        # banner display layer, so one mechanism covers both.\n        value = CoreConfig.get_config_field(\n            self.__config, \"fgo\", \"server\", \"enabled_singularity_ids\", default=None\n        )\n        return value if isinstance(value, list) else None\n\n    @property\n    def loglevel(self) -> int:"
    },
    {
      "file": "index.py",
      "anchor_old": "        enabled_ids = self.game_cfg.server.enabled_tlf_open_ids\n",
      "anchor_new": "        enabled_ids = self.game_cfg.server.enabled_tlf_open_ids\n        self.logger.info(\n            \"Terminal banner filter: enabled_ids=%r (open_ids before filter=%s)\",\n            enabled_ids, sorted(open_ids),\n        )\n"
    },
    {
      "file": "index.py",
      "anchor_old": "        extra_interlude_scenario_ids = {\n            25,  # Da Vinci (Rider)\n            27,  # GUDAGUDA Honnouji\n            41,  # Elena Christmas\n        }\n        result = []\n        for priority, catalog_row in enumerate(\n            sorted(\n                (\n                    row\n                    for row in self._story_tlf_catalog()\n                    if int(row[\"tlf_scenario_id\"])\n                    not in extra_interlude_scenario_ids\n                ),\n                key=lambda row: int(row[\"tlf_scenario_id\"]),\n            ),\n            start=1,\n        ):\n            tlf_scenario_id = int(catalog_row[\"tlf_scenario_id\"])",
      "anchor_new": "        extra_interlude_scenario_ids = {\n            25,  # Da Vinci (Rider)\n            27,  # GUDAGUDA Honnouji\n            41,  # Elena Christmas\n        }\n        # fgo_event_toggles_v1: None preserves original behavior exactly.\n        enabled_singularity_ids = self.game_cfg.server.enabled_singularity_ids\n        catalog_rows = list(self._story_tlf_catalog())\n        self.logger.info(\n            \"Open-events catalog: %d rows, distinct singularity_ids=%s\",\n            len(catalog_rows),\n            sorted({int(row[\"singularity_id\"]) for row in catalog_rows}),\n        )\n        result = []\n        for priority, catalog_row in enumerate(\n            sorted(\n                (\n                    row\n                    for row in catalog_rows\n                    if int(row[\"tlf_scenario_id\"])\n                    not in extra_interlude_scenario_ids\n                    and (\n                        enabled_singularity_ids is None\n                        or int(row[\"singularity_id\"]) in enabled_singularity_ids\n                    )\n                ),\n                key=lambda row: int(row[\"tlf_scenario_id\"]),\n            ),\n            start=1,\n        ):\n            tlf_scenario_id = int(catalog_row[\"tlf_scenario_id\"])"
    }
  ]
